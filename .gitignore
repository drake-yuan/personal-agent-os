# dependencies
node_modules/

# build output
dist/

# test / tool caches
.vitest-cache/
.tmp/

# database and runtime state (rebuilt from code + logs)
data/*.db
data/*.db-wal
data/*.db-shm
data/eval-runs/
# host-specific path alias table (cross-machine contract paths) - never commit
data/path-aliases.json

# secrets - never commit
.env
.env.*
*.pem
*.key
installation.secret

# ...but the template IS documentation: ship it so users know what to set.
# Without this the `.env.*` rule above would also swallow `.env.example`,
# which the README and setup instructions point at.
!.env.example

# OS
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/
*.swp
