# Example environment configuration for Personal Agent OS.
#
# Copy this file to `.env` (which is git-ignored) and adjust values.
# All variables are optional except where noted; nothing is read from the network.

# Directory that holds paos.db and installation.secret (mode 0600).
PAOS_DATA_DIR=data

# Local API bind address. Never use 0.0.0.0 in v0.1 - remote access is a
# separate security mode (v0.2+).
PAOS_API_HOST=127.0.0.1
PAOS_API_PORT=8787

# Minimum accepted SQLite runtime version. Lowering this accepts the WAL-reset
# risk explicitly (Node 22.22 bundles 3.51.2). It is never bypassed silently.
PAOS_MIN_SQLITE_VERSION=3.51.3

# On sandboxed shells where the system temp dir is not writable, point these
# inside the workspace (use Windows backslash paths on Git Bash):
# TEMP=D:\Personal Agent OS\code\.tmp
# TMP=D:\Personal Agent OS\code\.tmp
# TMPDIR=D:\Personal Agent OS\code\.tmp

# WorkBuddy cloud adapter (gate G3 - OAuth app review pending).
# No endpoint is assumed by default: the adapter stays unconfigured and fails
# closed until both are set. Never commit real values here.
PAOS_WORKBUDDY_ENDPOINT=
PAOS_WORKBUDDY_TOKEN=
# OAuth client credentials, once the reviewed app exists:
# PAOS_WORKBUDDY_CLIENT_ID=
# PAOS_WORKBUDDY_CLIENT_SECRET=
